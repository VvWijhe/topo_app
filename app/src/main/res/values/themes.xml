<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Hoofdthema: de app tekent alles zelf in Compose -->
    <style name="Theme.Topo" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Opstartscherm (Android 12+ splash-API, via core-splashscreen ook op oudere versies) -->
    <style name="Theme.Topo.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Topo</item>
    </style>
</resources>
